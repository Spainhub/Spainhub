/**********************************************************************
 * 11_Info.gs — ЛИСТ INFO (README проекта)
 * Меню «Отчёты МП» → «Листы» → «Обновить INFO» (и при первом запуске WB).
 **********************************************************************/
function Info_build() {
  const ss = SpreadsheetApp.getActive();
  let sh = ss.getSheetByName(SHEET_INFO);
  if (!sh) sh = ss.insertSheet(SHEET_INFO, 0);
  sh.clear();

  const now = new Date();
  const roles = Setup_roles_().map(r => [r[0], r[1]]);
  const rows = [
    ['WB / Ozon API → Google Sheets — P&L отчёт (README)', ''],
    ['', ''],
    ['ОБЩЕЕ', ''],
    ['Назначение', 'Загрузка данных Wildberries и Ozon в Google Sheets, отчёты P&L / по товарам / unit-экономика, Web App.'],
    ['Поток данных', 'WB API → очередь загрузки (05_Wb_Load) → DATA_WB → ваши формулы в P&L ОТЧЕТ / ТОВАРЫ / UNIT / СПРАВКА → Web App.'],
    ['Web App (5 вкладок)', 'ПАРАМЕТРЫ · P&L ОТЧЕТ · ТОВАРЫ · UNIT · СПРАВКА. Название вкладки = имя листа. Данные перечитываются из листов каждые ~40 с.'],
    ['', ''],
    ['ЛИСТЫ (порядок — 00_Config.gs → SHEET_ORDER)', '']
  ].concat(roles).concat([
    ['', ''],
    ['СКРИПТЫ: порядок файлов в проекте Apps Script', ''],
    ['00_Config', 'Все имена листов, раскладка листов, настройки. Загружается первым.'],
    ['01_Utils', 'Даты, числа, формат ячеек, нумерация строк (иерархия), выпадающие списки, кэш.'],
    ['02_Formulas_RU', 'Формулы на русском (запись и перевод листа).'],
    ['03_Auth', 'Хранение API-ключей (меню Wildberries / Ozon).'],
    ['04_Menu', 'Меню «Отчёты МП», открытие Web App (doGet).'],
    ['05_Wb_Load', 'Загрузка WB: точки входа, очередь, API, журнал LOG.'],
    ['06_Wb_Sheet', 'Запись в DATA_WB, нормализация, очистка старше 3 месяцев.'],
    ['07_Wb_Reports', 'SKU_WB (товары) и REPORT_WB (эквайринг).'],
    ['08_Oz_Reports', 'REPORT_OZ (cash flow) и SKU_OZ (товары Ozon).'],
    ['09_Data_Check', 'Контроль полноты DATA_WB → лист DATA_CHECK, письмо при проблемах.'],
    ['10_Setup', 'Проверка/создание листов и их порядок.'],
    ['11_Info', 'Этот лист.'],
    ['12_Web_App … 17_Web_Ref', 'Серверные вызовы вкладок Web App: App, Params, Pnl, Goods, Unit, Ref.'],
    ['Index + Css + Js_*', 'HTML-файлы Web App (страница, стили, скрипты вкладок).'],
    ['', ''],
    ['ВКЛАДКИ WEB APP', ''],
    ['ПАРАМЕТРЫ', 'Заголовки A6:C6, параметры с 7-й строки. Ячейки колонки C с выпадающим списком — списки в приложении; выбор записывается в таблицу и наоборот.'],
    ['P&L ОТЧЕТ', 'Нумерация в колонке A (1, 1.1, 2, 2.1, 2.1.1 …) задаёт сворачивание строк. Формат колонки A лучше сделать «Обычный текст» (иначе «1.10» превратится в «1.1»). Графики при наведении: у строк-итогов и строк, подходящих под PNL_SERIES_RULES.'],
    ['ТОВАРЫ', 'Колонки читаются по заголовкам строки 6; формулы — ваши (себестоимость — из COGS).'],
    ['UNIT', 'Артикул — C5 (выпадающий список). Нумерация строк, как в P&L ОТЧЕТ. Колонки без даты в строке 6 скрыты.'],
    ['СПРАВКА', 'Номер отчёта — выпадающий список в B2. Заголовки строки 6: № | Страна: | Итого | страны… (список стран можно расширять).'],
    ['Фильтр периода', 'E2 («Дата от») и G2 («Дата до») на листах P&L ОТЧЕТ, ТОВАРЫ, UNIT; рабочий период — E4 / G4.'],
    ['', ''],
    ['РЕШЕНИЕ ПО ДАТАМ (DATA_WB)', ''],
    ['Тип', 'Нативный Date БЕЗ времени (UTC-полдень: 12:00 UTC). Защита от сдвига на ±1 день в любом часовом поясе.'],
    ['Формат ячеек', '"dd.MM.yyyy" → видна только дата. Формулы СУММЕСЛИМН/ДАТА работают — это настоящие даты, а не текст.'],
    ['ISO-датавремя', '"2026-08-10T20:10:21Z" → Date(10.08.2026). Время отброшено, день в MSK.'],
    ['', ''],
    ['ФОРМУЛЫ', ''],
    ['Язык', 'Скрипт пишет формулы на русском. Если в ячейках видны английские названия: Файл → Настройки → снять «Всегда использовать английские названия функций». Меню «Листы»: «Формулы активного листа → на русском».'],
    ['', ''],
    ['АВТОЗАГРУЗКА', ''],
    ['Триггер WB', 'dailyUpdate раз в день (меню Wildberries → «Включить ежедневную автозагрузку»). Ставить от имени пользователя, чей токен WB сохранён.'],
    ['Перекрытие', `Каждый день перезапрашиваются последние ${DAILY_OVERLAP_DAYS} дней; дубликаты отсекаются по rrdId.`],
    ['Таймаут', 'Прогресс хранится в очереди (ScriptProperties), продолжение — автоматически через 1 мин.'],
    ['Пропуски', 'После загрузки — проверка (лист DATA_CHECK), письмо при проблемах, авто-дозагрузка пропусков (до 3 попыток на день).'],
    ['Ozon', 'Ежемесячная автозагрузка 10-го числа за прошлый месяц (меню Ozon).'],
    ['', ''],
    ['ТОКЕНЫ / КЛЮЧИ', ''],
    ['WB', 'Меню «Отчёты МП» → «Wildberries» → «Добавить API-ключ». Категории: Финансы, Цены и скидки, Маркетплейс (без «Финансы» — 403).'],
    ['Ozon', 'Меню «Отчёты МП» → «Ozon» → «Добавить Ozon Client ID».'],
    ['Хранение', 'PropertiesService.getUserProperties() — не в коде, привязаны к пользователю.'],
    ['', ''],
    ['КАК РАСШИРЯТЬ', ''],
    ['Новый лист/вкладка', 'Имя листа — в 00_Config.gs (SHEET_*, SHEET_ORDER, WEB_TABS), серверный вызов — новый файл 1X_Web_*.gs, страница — Js_*.html.'],
    ['Окно хранения', 'MAX_MONTHS_BACK (месяцев, от 1-го числа) в 00_Config.gs.'],
    ['Часовой пояс', 'MSK_OFFSET_HOURS (сейчас 3), TZ_MSK.'],
    ['Права записи', 'WEB_REQUIRE_EDITOR = true — менять параметры/артикул/период из Web App могут только редакторы таблицы.'],
    ['', ''],
    ['Последнее обновление', formatRu(now) + ' ' + formatTime(now)]
  ]);

  sh.getRange(1, 1, rows.length, 2).setValues(rows);
  sh.getRange('A1').setFontSize(14).setFontWeight('bold');
  rows.forEach((r, i) => {
    const row = i + 1;
    if (r[0] && !r[1] && row > 1) {
      sh.getRange(row, 1, 1, 2).setFontWeight('bold').setBackground('#f3f3f3');
    }
  });
  sh.setColumnWidth(1, 240);
  sh.setColumnWidth(2, 700);
  sh.getRange('B:B').setWrap(true);
  sh.setFrozenRows(1);
}
