# Скопируйте в .env и замените значения. Файл .env НЕ коммитить.
APP_ENV=development            # development | production
LOG_LEVEL=INFO
TZ=Europe/Moscow
PROXY_PORT=8091               # порт на 127.0.0.1; выберите свободный (ss -tlnp)

POSTGRES_USER=winscoms
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=winscoms
# Приложение подключается ограниченной ролью APP_DB_USER (без прав суперпользователя — иначе не работает RLS).
DATABASE_URL=postgresql+asyncpg://winscoms_app:CHANGE_ME@db:5432/winscoms
# Владелец схемы — только для миграций Alembic:
MIGRATION_DATABASE_URL=postgresql+asyncpg://winscoms:CHANGE_ME@db:5432/winscoms
APP_DB_USER=winscoms_app
APP_DB_PASSWORD=CHANGE_ME

# Подпись сессий/CSRF. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
# Ключи Fernet через запятую (первый — для шифрования, остальные — для расшифровки при ротации).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEYS=CHANGE_ME

# Wildberries
WB_FINANCE_API_URL=https://finance-api.wildberries.ru
WB_MIN_INTERVAL_SECONDS=65      # лимит токена: 1 запрос в минуту + запас
WB_PAGE_LIMIT=20000             # записей на страницу (API допускает до 100000)
WB_REPORT_PERIOD=daily          # значение параметра period — подтвердить по документации
HISTORY_MONTHS=3
